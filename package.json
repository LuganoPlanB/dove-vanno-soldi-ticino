    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.51.0",
    "next-themes": "^0.4.6",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/d3-sankey": "^0.12.4",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.56.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
