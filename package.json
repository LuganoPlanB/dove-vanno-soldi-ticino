{
  "name": "dove-vanno-soldi-ticino",
  "version": "1.0.0",
  "type": "module",
  "description": "Visualizzazione trasparente delle finanze del Canton Ticino",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
